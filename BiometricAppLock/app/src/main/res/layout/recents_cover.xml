<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recentsCoverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recents_cover"
    android:filterTouchesWhenObscured="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_lock"
        android:tint="@color/recents_cover_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/recents_cover_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/recents_cover_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/recents_cover_body"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/recents_cover_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recentsCoverHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/recents_cover_home" />
</LinearLayout>
